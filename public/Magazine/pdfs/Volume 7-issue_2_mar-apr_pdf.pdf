<<
/Type /StructElem
/S /P
/P 130 0 R
/E (Clinical image interpretation [5], [8])
/Pg 14 0 R
/K [12]
>>
endobj
243 0 obj
<<
/Type /StructElem
/S /P
/P 130 0 R
/E (Detection of biomarkers [4])
/Pg 14 0 R
/K [13]
>>
endobj
244 0 obj
<<
/Type /StructElem
/S /P
/P 130 0 R
/E (Disease modeling [3])
/Pg 14 0 R
/K [14]
>>
endobj
245 0 obj
<<
/Type /StructElem
/S /P
/P 130 0 R
/E (Deep learning uses neural networks to automatically learn patterns from complex medical data. It follows a structured pipeline starting from data collection to final prediction is shown in fig 1. )
/Pg 14 0 R
/K [15]
>>
endobj
246 0 obj
<<
/Type /StructElem
/S /P
/P 130 0 R
/E (Fig. 1: Deep Learning pipeline for early detection of neurodegenerative diseases. )
/Pg 14 0 R
/K [16]
>>
